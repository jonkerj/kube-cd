      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Sensorbox currents",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "influxdb",
                      "version": "v0",
                      "spec": {
                        "query": "import \"strings\"\nfrom(bucket: \"smartevse\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"smartevse\")\n  |> filter(fn: (r) => r[\"_field\"] == \"phase_current_l1\" or r[\"_field\"] == \"phase_current_l2\" or r[\"_field\"] == \"phase_current_l3\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({ r with _field: strings.replace(v: r._field, t: \"phase_current_l\", u: \"L\", i: 1), _value: r._value / 10.0 }))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\n  |> yield(name: \"mean\")\n"
                      },
                      "labels": {
                        "grafana.app/export-label": "influxdb-1",
                        "grafana.app/export-datasource-name": "InfluxDB"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
